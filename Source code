-- ===== 1. TABLE CREATION =====
CREATE TABLE Owner
(
    owner_id      CHAR(4) PRIMARY KEY,
    owner_name    VARCHAR2(100) NOT NULL,
    phone_number  VARCHAR2(15),
    owner_address VARCHAR2(255)
);

CREATE TABLE Pet_Clinic
(
    clinic_name VARCHAR2(64) PRIMARY KEY,
    doctor_name VARCHAR2(100) NOT NULL,
    medicine    VARCHAR2(255),
    equipment   VARCHAR2(255),
    address     VARCHAR2(255)
);

CREATE TABLE Pet_Store
(
    store_id      CHAR(4) PRIMARY KEY,
    store_name    VARCHAR2(100) NOT NULL,
    store_address VARCHAR2(255),
    pet_grooming  VARCHAR2(100),
    staff_name    VARCHAR2(100),
    pet_supplies  VARCHAR2(255)
);

CREATE TABLE Pet
(
    pet_name   VARCHAR2(64) PRIMARY KEY,
    age        NUMBER,
    fur_color  VARCHAR2(50),
    type       VARCHAR2(50),
    body_build VARCHAR2(50),
    owner_id   CHAR(4),
    CONSTRAINT fk_pet_owner FOREIGN KEY (owner_id)
        REFERENCES Owner(owner_id)
);

CREATE TABLE Clinic_Visit
(
    visit_id    NUMBER PRIMARY KEY,
    pet_name    VARCHAR2(64),
    clinic_name VARCHAR2(64),
    visit_date  DATE,
    fee         NUMBER,
    status      VARCHAR2(20),
    CONSTRAINT fk_visit_pet FOREIGN KEY (pet_name)
        REFERENCES Pet(pet_name),
    CONSTRAINT fk_visit_clinic FOREIGN KEY (clinic_name)
        REFERENCES Pet_Clinic(clinic_name)
);

